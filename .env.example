# ==============================================================================
# Cognitive Lattice Engine (CLE) v1.0.0 Environment Configuration
# ==============================================================================

# Database Mode Selection:
# 1. PGlite Embedded Mode (Local-First, default):
#    Runs embedded PostgreSQL 16 directly inside the Node.js process with pgvector.
#    No external PostgreSQL server required. Data is persisted to PGLITE_DATA_DIR.
USE_PGLITE=true

# Local PGlite Persistent Storage Directory:
# Defaults to .cle-pglite-data in the workspace root if not specified.
# In test mode (NODE_ENV=test), PGlite automatically runs in-memory for isolation.
PGLITE_DATA_DIR=.cle-pglite-data

# 2. External PostgreSQL 16 + pgvector Mode (Optional):
#    Set USE_PGLITE=false and provide a valid PostgreSQL 16 connection string.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/cognitive_lattice

# Redis & BullMQ (Optional - used for asynchronous task workers):
REDIS_URL=redis://localhost:6379

# AI API Keys (Optional - CLE supports direct offline mode or frontier AI integration):
# OpenAI API Key (used for text-embedding-3-small and GPT-4o integration)
OPENAI_API_KEY=

# Gemini API Key (used for Gemini 4 Argon High Thinking bridge and embeddings)
GEMINI_API_KEY=

# Node Environment: development | production | test
NODE_ENV=development
